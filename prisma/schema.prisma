// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
 
}

enum Role {
  ADMIN
  VIEWER
  EDITOR
  OWNER
}


// Update your existing schema.prisma

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id          String         @id @default(uuid())
  name        String         
  status      DocumentStatus @default(PENDING)
  fileUrl     String         
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String   // Stores the plaintext segment that matches Chroma's ID
  pageNumber Int      
  createdAt  DateTime @default(now())
}

enum SystemRole {
  SUPER_ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id         String            @id @default(uuid())
  email      String            @unique
  password   String
  role       SystemRole        @default(USER) // Global application role
  memberships WorkspaceMember[] // Workspaces this user can access
  createdAt  DateTime          @default(now())
}

model Workspace {
  id        String            @id @default(uuid())
  name      String            // e.g., "Achref's Second Brain" or "Neat Agency Workspace"
  members   WorkspaceMember[]
  documents Document[]
  createdAt DateTime          @default(now())
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER) // RBAC inside the specific workspace!
  
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId]) // A user can only be in a workspace once
}

